# Apache .htaccess Configuration for Raport Monitoring
# This file secures your application

# Protect config.php from direct access
<Files "config.php">
    Order allow,deny
    Deny from all
</Files>

# Protect database.sql from direct access
<Files "database.sql">
    Order allow,deny
    Deny from all
</Files>

# Protect .txt template files from direct access (optional)
<FilesMatch "\.(txt)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable error pages (optional)
ErrorDocument 404 /404.html
ErrorDocument 403 /403.html

# Set default index files
DirectoryIndex index-web.html index.html

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Disable directory browsing
Options -Indexes

# Enable PHP error logging (disable in production)
php_flag display_errors off
php_flag log_errors on

# Increase upload size limits for screenshots (adjust as needed)
php_value upload_max_filesize 10M
php_value post_max_size 10M
php_value max_execution_time 300
php_value max_input_time 300
